PORT=4300
NODE_ENV=development
# Postgres connection string (local Docker or a managed provider such as Neon).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/secure_pitch
REDIS_URL=redis://localhost:6380
STORAGE_URL=http://localhost:4100
STORAGE_TOKEN=dev-storage-token-change-me
SLIDE_WIDTH=1920
SLIDE_QUALITY=80
# Standard tier: default on slower networks.
SLIDE_WIDTH_STANDARD=1280
SLIDE_QUALITY_STANDARD=72
# Preview tier: tiny image shown instantly while the rest loads.
SLIDE_WIDTH_PREVIEW=384
SLIDE_QUALITY_PREVIEW=55