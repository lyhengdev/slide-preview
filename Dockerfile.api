# syntax=docker/dockerfile:1
FROM node:22-slim AS base
RUN corepack enable
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

FROM base AS build
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @ke/database db:generate
RUN pnpm --filter @ke/api build

FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/packages/config/node_modules ./packages/config/node_modules
COPY --from=build /repo/packages/database/node_modules ./packages/database/node_modules
COPY --from=build /repo/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=build /repo/packages/types/node_modules ./packages/types/node_modules
COPY --from=build /repo/packages/validation/node_modules ./packages/validation/node_modules
COPY --from=build /repo/packages/database/generated ./packages/database/generated
COPY --from=build /repo/packages/*/dist ./packages/*/dist
COPY --from=build /repo/apps/api/dist ./apps/api/dist
EXPOSE 4000
WORKDIR /repo/apps/api
CMD ["node", "--import", "tsx", "--enable-source-maps", "dist/server.js"]