PORT=4000
NODE_ENV=development
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated (WEB_URL is always allowed).
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/secure_pitch
REDIS_URL=redis://localhost:6380
STORAGE_URL=http://localhost:4100
STORAGE_TOKEN=change-me-storage-token
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret
COOKIE_SECURE=false
QR_TOKEN_TTL_SECONDS=900
JUDGE_SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=12
# Demo admin account created by `pnpm seed`
DEMO_ADMIN_EMAIL=admin@ke.local
DEMO_ADMIN_PASSWORD=admin123
