PORT=4100
DATA_DIR=./var/data
STORAGE_TOKEN=dev-storage-token-change-me
NODE_ENV=development

# Object storage backend (S3-compatible, e.g. Neon Storage). The service falls
# back to the local DATA_DIR disk when these are not all set.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=charaxke