{
  "name": "@ke/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "tsx src/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@ke/auth": "workspace:*",
    "@ke/config": "workspace:*",
    "@ke/database": "workspace:*",
    "@ke/types": "workspace:*",
    "@ke/validation": "workspace:*",
    "bullmq": "^5.28.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}